{
  "name": "servidor-local-de-arquivos",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo desktop para compartilhar arquivos na rede local.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run build && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run dev",
    "test": "node --test",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "br.local.servidorarquivos",
    "productName": "Servidor Local de Arquivos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo_type/logotipo.ico"
    }
  }
}
